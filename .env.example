# =====================================================================
#  SNS AI Marketing — 환경 설정 파일 예시
#  1) 이 파일을 복사해서 이름을 .env 로 바꾸세요:  cp .env.example .env
#  2) 필요한 값만 채우세요. 비워 두면 해당 기능은 Mock(가짜) 모드로 동작합니다.
#  3) .env 는 .gitignore 에 등록되어 Git 에 올라가지 않습니다.
#  ※ 대시보드의 [설정 > API Key] 화면에서 입력해도 됩니다 (data/secrets.env 에 저장).
# =====================================================================

# --- 안전 모드 ---------------------------------------------------------
# true  : 실제 SNS 게시 / 광고 수정 / 돈 사용 없음. "~했을 것" 로그만 남김 (기본값, 처음엔 꼭 true)
# false : 승인된 콘텐츠가 실제로 게시됩니다. 모든 테스트가 끝난 뒤에만 바꾸세요.
DRY_RUN=true

# --- 기본 시장: 일본 ------------------------------------------------------
# 콘텐츠는 일본어가 기본입니다. 한국어/영어는 화면이나 AI 매니저에서 요청할 때만 사용합니다.
DEFAULT_COUNTRY=JP
DEFAULT_LANGUAGE=ja
DEFAULT_CURRENCY=JPY
DEFAULT_TIMEZONE=Asia/Tokyo

# 외부에서 접속 가능한 이 서버 주소 (OAuth 리다이렉트에 사용)
PUBLIC_BASE_URL=http://localhost:8000

# 데이터베이스 — 비워 두면 data/app.db (SQLite)
# PostgreSQL 예: postgresql+psycopg://user:pass@localhost:5432/sns_ai
DATABASE_URL=

# --- Claude API (https://console.anthropic.com) ------------------------
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5
# low / medium / high — 높을수록 품질↑ 비용↑
CLAUDE_EFFORT=medium

# --- Meta (Instagram / Facebook / Ads) ---------------------------------
META_GRAPH_VERSION=v26.0
# Instagram API with Instagram Login (권장): 대시보드에서 [Instagram 연결] 버튼으로 토큰 자동 저장
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_USER_ID=
# Facebook Login 토큰을 쓰는 경우 graph.facebook.com 으로 변경
INSTAGRAM_API_HOST=graph.instagram.com
# Facebook 페이지 게시용 (Page access token)
FACEBOOK_PAGE_ID=
FACEBOOK_PAGE_ACCESS_TOKEN=
# Meta 광고 (ads_read / ads_management 권한의 System User 토큰 권장)
META_ADS_ACCESS_TOKEN=
META_AD_ACCOUNT_ID=

# --- TikTok (Content Posting API) --------------------------------------
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
# [TikTok 연결] 버튼으로 자동 저장됩니다
TIKTOK_ACCESS_TOKEN=
TIKTOK_REFRESH_TOKEN=
# 앱 심사 전에는 SELF_ONLY 만 가능
TIKTOK_PRIVACY_LEVEL=SELF_ONLY

# --- X API (OAuth 2.0) -------------------------------------------------
X_CLIENT_ID=
X_CLIENT_SECRET=
# [X 연결] 버튼으로 자동 저장됩니다
X_ACCESS_TOKEN=
X_REFRESH_TOKEN=

# --- 미디어 공개 URL (Instagram / TikTok 은 공개 URL 의 파일만 가져갈 수 있음) ---
# 예: https://my-server.example.com  → 업로드 파일이 /media/파일명 으로 공개됨
PUBLIC_MEDIA_BASE_URL=

# --- 이미지 / 영상 / 음성 생성 --------------------------------------------
# template: 서버에서 깔끔한 일본 광고 스타일 이미지를 직접 디자인 (무료, 기본)
# openai  : OpenAI 이미지 API 로 배경 비주얼 생성 + 일본어 문구는 서버에서 합성 (유료)
IMAGE_PROVIDER=template
OPENAI_API_KEY=
OPENAI_IMAGE_MODEL=gpt-image-1
# slideshow: 장면 + 일본어 자막(+음성)으로 9:16 mp4 를 생성 (ffmpeg 필요) / none: 장면 정보·프롬프트만
VIDEO_PROVIDER=slideshow
# 일본어 음성(VOICEVOX). Docker: docker compose --profile voice up 후 http://voicevox:50021
VOICEVOX_URL=
# 일본어 폰트 경로 (비우면 자동 탐색)
FONT_PATH=
# 트렌드 조사에 Claude 웹 검색 사용 (검색 1회당 추가 요금)
TREND_WEB_SEARCH=true

# --- 리포트 알림 (선택) ------------------------------------------------
SLACK_WEBHOOK_URL=
DISCORD_WEBHOOK_URL=
