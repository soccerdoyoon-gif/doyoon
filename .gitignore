# --- 비밀값: 절대 Git 에 올리지 않음 ---
.env
.env.*
!.env.example
data/secrets.env
*.pem
*.key

# --- 런타임 데이터 / 로그 ---
data/*
!data/.gitkeep
logs/*
!logs/.gitkeep

# --- Python ---
__pycache__/
*.py[cod]
.pytest_cache/
.venv/
venv/
*.egg-info/

# --- Node / Frontend ---
node_modules/
frontend/dist/
frontend/.vite/

# --- OS / IDE ---
.DS_Store
Thumbs.db
.idea/
.vscode/

# --- AI 생성 파일 (이미지/영상) ---
assets/generated/
!assets/.gitkeep
